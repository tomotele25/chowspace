# Copy to .env.local and fill in. Real .env files are gitignored.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Backend ---
# REST API. Set to http://localhost:2005 to develop against a local backend.
NEXT_PUBLIC_API_URL=https://chowspace-backend.vercel.app
# Realtime chat sockets. Kept separate because Vercel is serverless and
# cannot hold a WebSocket connection open; chat runs on Render instead.
NEXT_PUBLIC_SOCKET_URL=https://chowspace-backend-1.onrender.com

# --- Payments (publishable keys only) ---
NEXT_PUBLIC_FLW_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- "Get the app" banner ---
# iOS App Store listing. Defaults to the live URL in components/GetAppBanner.js
# if left unset, so this only needs setting to override it.
NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/ng/app/chowspace/id6800899251
